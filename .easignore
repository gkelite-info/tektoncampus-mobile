# EAS Build Ignore Rules
# When .easignore exists, EAS CLI ignores .gitignore completely.
# We must explicitly list all files/directories to ignore here.

# Dependency directories
node_modules
node_modules/**

# Git directories & metadata
.git
.git/**
.github
.github/**

# Local configuration and environment secrets (CRITICAL for security)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*

# Native keystores and credentials (CRITICAL for security)
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Native directories (Managed Workflow)
# Since you have an 'android' folder locally from running 'expo run:android',
# ignoring 'android' and 'ios' here ensures EAS Build runs 'expo prebuild' fresh
# on the server. This prevents stale native files from being uploaded and
# respects the configuration in app.json (e.g. package name, plugins, etc.).
android
android/**
ios
ios/**

# Expo directories and caches
.expo
.expo/**
dist
dist/**
web-build
web-build/**

# IDE files
.idea
.idea/**
.vscode
.vscode/**

# Build inspection folders
eas-inspect
eas-inspect/**

# Temporary files & logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
.DS_Store
.metro-health-check*
