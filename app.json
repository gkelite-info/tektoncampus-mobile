{
  "expo": {
    "name": "Tekton Campus",
    "slug": "tekton-campus",
    "version": "1.0.0",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-localization",
      "expo-router"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gkelite.tektoncampus",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Tekton Campus needs access to your camera to capture photos for profile pictures and assignments.",
        "NSPhotoLibraryUsageDescription": "Tekton Campus needs access to your photo library to upload assignments and profile pictures.",
        "NSMicrophoneUsageDescription": "Tekton Campus needs access to your microphone for video recording.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.gkelite.tektoncampus"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "029c6ed1-b6cc-4aea-a963-2145d14c9818"
      }
    },
    "owner": "ashishgkelite"
  }
}
